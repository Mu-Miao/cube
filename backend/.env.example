CONTROL_MAX_RETRIES=3

MQTT_BROKER_URL=
MQTT_BROKER_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=true
MQTT_CA_CERT=

FIRMWARE_PUBLIC_BASE_URL=https://tianmuzc.site/
CORS_ORIGINS=["http://localhost:5173"]

