DEBUG=true
WEB_CONCURRENCY=1
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_SECURE=false
LOGIN_FAILURE_LIMIT=10
LOGIN_LOCKOUT_SECONDS=900
DEVICE_TOKEN_EXPIRE_SECONDS=14400

DATABASE_URL=sqlite+aiosqlite:///./data/cube.db
REDIS_URL=
DEMO_MODE=false
CONTROL_ACK_TIMEOUT_SECONDS=15
CONTROL_MAX_RETRIES=3

MQTT_BROKER_URL=
MQTT_BROKER_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=true
MQTT_CA_CERT=

FIRMWARE_PUBLIC_BASE_URL=https://tianmuzc.site/
FIRMWARE_MAX_UPLOAD_BYTES=10485760
JSON_MAX_REQUEST_BYTES=1048576
CORS_ORIGINS=["http://localhost:5173"]

WS_AUTH_TIMEOUT_SECONDS=5
WS_MAX_UNAUTHENTICATED_CONNECTIONS=10

LLM_MODE=off
LLM_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
DASHSCOPE_API_KEY=
LLM_API_MODEL=qwen3.6-flash
LLM_API_ENABLE_THINKING=false
LLM_LOCAL_BASE_URL=http://localhost:11434/v1
LLM_LOCAL_MODEL=qwen2.5:3b
LLM_TIMEOUT=120
LLM_LOCAL_TIMEOUT=120
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=512

